# docker-compose-env 环境变量模板
# 使用方式: 复制为 .env 后按需修改，或直接使用默认值
# cp .env.example .env

# ---------- PostgreSQL 18 ----------
POSTGRES_DB=teamgram
POSTGRES_USER=teamgram
POSTGRES_PASSWORD=teamgram
# Single runall-docker instance can open up to about 216 configured
# PostgreSQL connections. Override this when scaling replicas or changing
# service pool sizes.
TEAMGRAM_POSTGRES_MAX_CONNECTIONS=256

# ---------- Product Identity -> AIMemory bridge (optional) ----------
# Teamgram calls Identity only after validating an encrypted MTProto proof.
# Set every bridge value below when enabling the integration. The base
# Teamgram Compose file leaves Identity and replay Redis as external services.
TEAMGRAM_IDENTITY_BASE_URL=
TEAMGRAM_IDENTITY_TEAMGRAM_SERVICE_TOKEN=
TEAMGRAM_IDENTITY_INSTANCE_ID=default
TEAMGRAM_IDENTITY_REQUEST_TIMEOUT_SECONDS=5
TEAMGRAM_IDENTITY_REPLAY_REDIS_HOST=
TEAMGRAM_IDENTITY_REPLAY_REDIS_PASS=
TEAMGRAM_IDENTITY_REPLAY_REDIS_TLS=false
TEAMGRAM_IDENTITY_REPLAY_TTL_SECONDS=60

# ---------- S3-compatible object storage (SeaweedFS by default) ----------
# These values are disposable local defaults. Production overlays must provide
# credentials explicitly through a secret manager or external Docker secrets.
S3_ENDPOINT=seaweedfs:8333
S3_ACCESS_KEY=seaweedfs
S3_SECRET_KEY=seaweedfs-secret
S3_USE_SSL=false
S3_REGION=us-east-1
SEAWEEDFS_S3_PORT=8333

# ---------- Grafana ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3000
