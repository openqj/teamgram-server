FROM alpine:3.22 AS isolated-gateway
RUN apk add --no-cache socat

FROM mysql:8.0 AS isolated-mysql
COPY teamgram-server/teamgramd/deploy/sql/ /docker-entrypoint-initdb.d/
RUN rm /docker-entrypoint-initdb.d/migrate-20260309.sql
COPY teamgram-server/docker/web-isolated/mysql-init/zz-web-isolated-test-accounts.sql /docker-entrypoint-initdb.d/zz-web-isolated-test-accounts.sql

FROM mysql:8.0 AS isolated-mysql-fixture
COPY teamgram-server/docker/web-isolated/mysql-init/zz-web-isolated-test-accounts.sql /opt/zz-web-isolated-test-accounts.sql

FROM golang:1.23.0 AS builder
ARG GOFLAGS=-p=2
WORKDIR /app/teamgram-server
COPY teamgram-server/ ./
COPY proto/ /app/proto/
RUN for attempt in 1 2 3; do \
      bash -e ./build.sh && exit 0; \
      test "$attempt" -lt 3 || exit 1; \
      sleep 3; \
    done

# Reuse the local ARM64 runtime layer used by the previous isolated stack. It
# already contains ffmpeg, bash, and the process utilities needed by the
# service entrypoints; only the freshly built Teamgram binaries are replaced.
FROM teamgram-web-isolated-runtime:20260929-bff-05fe5dda AS teamgram-app
WORKDIR /app
COPY --from=builder /app/teamgram-server/teamgramd/ /app/
RUN chmod +x /app/docker/entrypoint.sh /app/docker/entrypoint-web-isolated.sh
ENTRYPOINT ["/app/docker/entrypoint-web-isolated.sh"]
