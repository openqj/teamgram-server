# syntax=docker/dockerfile:1.7
FROM --platform=linux/arm64 golang:1.25.0 AS builder

ARG GOFLAGS=-p=2
ENV GOPROXY=https://goproxy.cn,direct \
    GOOS=linux \
    GOARCH=arm64 \
    CGO_ENABLED=1

WORKDIR /app/teamgram-server
COPY teamgram-server/ ./
COPY proto/ /app/proto/

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    bash -e ./build.sh

FROM --platform=linux/arm64 teamgram-server-latest:20261007-r28-prod

WORKDIR /app
COPY --from=builder /app/teamgram-server/teamgramd/bin/ /app/bin/
COPY --from=builder /app/teamgram-server/teamgramd/etc2/ /app/etc2/
COPY --from=builder /app/teamgram-server/teamgramd/docker/entrypoint.sh /app/docker/entrypoint.sh
RUN chmod +x /app/docker/entrypoint.sh

ENTRYPOINT ["/app/docker/entrypoint.sh"]

LABEL org.opencontainers.image.version="20261008-r29-prod" \
      org.opencontainers.image.description="PostgreSQL 18 runtime with current APIFull and Bot registry fixes"
