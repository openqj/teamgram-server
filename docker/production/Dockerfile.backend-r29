# syntax=docker/dockerfile:1.7
FROM --platform=linux/arm64 golang:1.25.0 AS builder

ARG GOFLAGS=-p=2
ENV GOPROXY=https://goproxy.cn,direct \
    GOOS=linux \
    GOARCH=arm64 \
    CGO_ENABLED=1

WORKDIR /app/teamgram-server
COPY teamgram-server/ ./
COPY proto/ /app/proto/

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    bash -e ./build.sh

FROM --platform=linux/arm64 ubuntu:24.04

ARG UBUNTU_MIRROR_IP=91.189.91.104

# Docker Desktop may not forward DNS for ports.ubuntu.com into BuildKit. Use
# the build-time mirror address for APT while keeping the source path and
# package signatures unchanged. build-r29.sh resolves and supplies the
# current address; the default keeps a direct Dockerfile build usable.
RUN case "$UBUNTU_MIRROR_IP" in \
       ''|*[!0-9.]*) echo "invalid UBUNTU_MIRROR_IP" >&2; exit 1 ;; \
     esac \
    && sed -i "s#http://ports.ubuntu.com#http://${UBUNTU_MIRROR_IP}#g" /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update -o Acquire::Retries=3 \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       ca-certificates ffmpeg psmisc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/teamgram-server/teamgramd/bin/ /app/bin/
COPY --from=builder /app/teamgram-server/teamgramd/etc2/ /app/etc2/
COPY --from=builder /app/teamgram-server/teamgramd/docker/entrypoint.sh /app/docker/entrypoint.sh
COPY --from=builder /app/teamgram-server/teamgramd/docker/healthcheck.sh /app/docker/healthcheck.sh
RUN chmod +x /app/docker/entrypoint.sh
RUN chmod +x /app/docker/healthcheck.sh

ENTRYPOINT ["/app/docker/entrypoint.sh"]

LABEL org.opencontainers.image.version="20261011-r29-prod" \
      org.opencontainers.image.description="PostgreSQL 18 runtime with current APIFull and Bot registry fixes"
