# syntax=docker/dockerfile:1.7
FROM golang:1.25.0 AS builder
WORKDIR /workspace/teamgram-server
COPY teamgram-server/go.mod teamgram-server/go.sum ./
COPY proto/ ../proto/
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY teamgram-server/ ./
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    GOFLAGS=-p=2 bash -e ./build.sh

FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates ffmpeg psmisc && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /workspace/teamgram-server/teamgramd/bin/ ./bin/
COPY --from=builder /workspace/teamgram-server/teamgramd/etc2/ ./etc2/
COPY --from=builder /workspace/teamgram-server/teamgramd/docker/ ./docker/
RUN chmod +x /app/docker/*.sh /app/bin/runall-docker.sh
ENTRYPOINT ["/app/docker/entrypoint.sh"]
